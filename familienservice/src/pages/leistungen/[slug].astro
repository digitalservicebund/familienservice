---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const leistungen = await getCollection("familienleistungen");
  return leistungen.map((leistung) => ({
    params: { slug: leistung.id },
    props: { leistung },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { leistung } = Astro.props;
const { Content } = await render(leistung);
---

<BaseLayout title={leistung.data.titel}>
  <p><a href="/leistungen/">Alle Familienleistungen</a></p>
  <h1>{leistung.data.titel}</h1>
  {leistung.data.beschreibung && <p>{leistung.data.beschreibung}</p>}
  <Content />
</BaseLayout>
