{
  "name": "fs-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "Familienservice Prototype(s)",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalservicebund/fs-prototype.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter familienservice build",
    "build:image": "docker build -t fs-prototype .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "pnpm --parallel --filter familienservice dev",
    "start:image": "docker run --init --rm -p 3000:3000 fs-prototype",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p familienservice"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.11.2"
}
