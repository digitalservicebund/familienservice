{
  // Only for scripts/ (e.g. the BAFzA import). The web app has its own web/tsconfig.json.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    // Node runs .ts files directly, so imports between them use the .ts extension.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
