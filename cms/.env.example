# Example configuration for local Strapi development.
#
# Create your local copy once (from the repository root):
#
#   cp -n cms/.env.example cms/.env
#
# cms/.env is ignored by Git, adjust it locally as needed.
#
# Secrets are 1Password secret references (op://<vault>/<item>/<field>). `op run`
# resolves them when Strapi or the database is started via the package scripts
# (pnpm cms:db, pnpm cms:dev). Create the 1Password item once with `pnpm cms:secrets`.
# If your vault is not called "Employee", replace "Employee" in your cms/.env.

# Server
HOST=0.0.0.0
PORT=1337

# Secrets (1Password references)
APP_KEYS=<secret-app-keys>
API_TOKEN_SALT=<secret-api-token-salt>
ADMIN_JWT_SECRET=<admin-jwt-secret>
TRANSFER_TOKEN_SALT=<transfer-token-salt>
JWT_SECRET=<jwt-secret>
ENCRYPTION_KEY=<encryption-key>

# Database (local PostgreSQL from compose.yaml)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=familienservice_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=<secret-pwd>
DATABASE_SSL=false
