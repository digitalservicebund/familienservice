    },
    "familienleistungen": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::familienleistung.familienleistung",
      "inversedBy": "lebenslagen"
    },
    "FAQ": {
      "type": "component",
      "component": "faq.faq-eintrag",
      "repeatable": true
    }
  }
